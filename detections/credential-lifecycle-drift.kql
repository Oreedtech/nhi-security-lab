// Credential lifecycle: secrets and certificates added to applications or service
// principals, and long-lived credentials approaching or past expiry.
//
// A managed identity has no credential to manage, which is why this lab prefers them. This
// detection exists for the population that cannot use one yet -- and to catch the case where
// somebody quietly adds a client secret to an app that was previously identity-only.
//
// Requires: AuditLogs.

AuditLogs
| where OperationName has_any (
    "Update application - Certificates and secrets management",
    "Update service principal/Update credentials",
    "Add service principal credentials")
| extend AppName = tostring(TargetResources[0].displayName)
| extend AppId   = tostring(TargetResources[0].id)
| extend Actor   = coalesce(
    tostring(InitiatedBy.user.userPrincipalName),
    tostring(InitiatedBy.app.displayName))
| mv-expand prop = parse_json(tostring(TargetResources[0].modifiedProperties))
| extend PropName = tostring(prop.displayName)
| where PropName in ("KeyDescription", "KeyCredentials", "PasswordCredentials")
| extend NewValue = tostring(prop.newValue)
| extend EndDate = todatetime(extract(@"EndDate=([0-9\-:TZ\.]+)", 1, NewValue))
| extend LifetimeDays = iff(isnull(EndDate), int(null), datetime_diff('day', EndDate, TimeGenerated))
| project TimeGenerated, AppName, AppId, Actor, PropName, EndDate, LifetimeDays, Result
// Two things worth a human: a credential minted to last more than a year, and any secret
// added by a principal that is not the app's registered owner.
| where LifetimeDays > 365 or isnull(LifetimeDays)
| order by TimeGenerated desc
